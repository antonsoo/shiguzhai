  "readings": [
    {
      "text": "鳧氏為鐘。",
      "characterOffsetWithoutPunctuation": 0,
      "characters": 4,
      "editorialTerminalFullStop": false
    },
    {
      "text": "兩欒謂之銑，銑間謂之于。",
      "characterOffsetWithoutPunctuation": 4,
      "characters": 10,
      "editorialTerminalFullStop": true
    },
    {
      "text": "于上謂之鼓，鼓上謂之鉦，鉦上謂之舞。",
      "characterOffsetWithoutPunctuation": 14,
      "characters": 15,
      "editorialTerminalFullStop": true
    },
    {
      "text": "十分其銑，去二以為鉦，以其鉦為之銑間。",
      "characterOffsetWithoutPunctuation": 69,
      "characters": 16,
      "editorialTerminalFullStop": true
    },
    {
      "text": "去二分以為之鼓間。",
      "characterOffsetWithoutPunctuation": 85,
      "characters": 8,
      "editorialTerminalFullStop": false
    },
    {
      "text": "以其鼓間為之舞修，去二分以為舞廣。",
      "characterOffsetWithoutPunctuation": 93,
      "characters": 15,
      "editorialTerminalFullStop": false
    }
  ],
