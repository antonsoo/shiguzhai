{
  "name": "@antonsoloviev/shiguzhai",
  "version": "0.2.0",
  "private": true,
  "description": "Ancient Chinese bell evidence: Shiguzhai observations, Piao-shi bending patterns and a Chinese craft-text workshop.",
  "type": "module",
  "author": "Anthony Mercer <anthony@praviel.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/antonsoo/shiguzhai.git"
  },
  "homepage": "https://antonsoo.github.io/shiguzhai/",
  "keywords": [
    "ancient-music",
    "chinese-bells",
    "archaeology",
    "acoustics",
    "education",
    "visualization"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4350 --strictPort",
    "build": "node scripts/shuang-assets.mjs && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4350 --strictPort",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "verify:source": "python3 scripts/source-oracle.py",
    "test:browser": "node scripts/browser-review.mjs",
    "verify:shuang-source": "python3 scripts/shuang-source-review.py",
    "test:shuang": "node scripts/shuang-browser-review.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.2",
    "@types/node": "24.19.2",
    "playwright": "1.63.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
